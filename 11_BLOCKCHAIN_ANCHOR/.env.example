#
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# Your deployer wallet private key (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# Basescan API key for contract verification
# Get one at: https://basescan.org/apis
BASESCAN_API_KEY=your_basescan_api_key

# Optional: Alchemy/Infura RPC URLs if you want custom endpoints
# BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY
# BASE_MAINNET_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
